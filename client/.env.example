# Base URL for the backend API.
# Dev: keep "/api" — Vite proxies it to the backend (see vite.config.js), no CORS.
# Prod: set the absolute API origin, e.g. https://api.yourdomain.com/api
VITE_API_URL=/api

# Socket.IO backend origin (direct connection, not proxied). Prod: wss/https API origin.
VITE_SOCKET_URL=http://localhost:5000

# Razorpay public key (key_id is safe on the client; secret stays server-side).
VITE_RAZORPAY_KEY_ID=
