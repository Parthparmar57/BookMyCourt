NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmycourt?schema=public"
JWT_ACCESS_SECRET="champions_club_jwt_access_secret_key_32chars_min"
JWT_REFRESH_SECRET="champions_club_jwt_refresh_secret_key_32chars_min"
CLIENT_URL="http://localhost:5173"

# Optional. Leave unset to disable online payments (endpoints will 503).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional. Leave unset to disable email notifications.
SMTP_HOST=""
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@championsclub.com"
